@model eUseControl.BeekeepingStore.Domain.Entities.Order.OrderResponse

@{
    ViewBag.Title = "Order Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-0">Order Confirmation</h1>
                <a href="@Url.Action("History", "Order")" class="btn btn-outline-primary">
                    <i class="fas fa-list me-2"></i>My Orders
                </a>
            </div>
            <div class="progress mt-3" style="height: 30px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Order placed successfully!</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="alert alert-success">
                <h4 class="alert-heading">Thank you for your order!</h4>
                <p>Order number <strong>#@Model.OrderId</strong> has been placed successfully and is being processed.</p>
                <p>You will receive a confirmation email with order details shortly.</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Details</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr>
                            <th style="width: 200px;">Order Number:</th>
                            <td>#@Model.OrderId</td>
                        </tr>
                        <tr>
                            <th>Date:</th>
                            <td>@Model.OrderDate.ToString("dd.MM.yyyy, HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td>
                                <span class="badge bg-warning">@Model.OrderStatus</span>
                            </td>
                        </tr>
                        <tr>
                            <th>Payment Method:</th>
                            <td>@Model.PaymentMethod</td>
                        </tr>
                        <tr>
                            <th>Payment Status:</th>
                            <td>
                                <span class="badge bg-@(Model.PaymentStatus == "Completed" ? "success" : Model.PaymentStatus == "Failed" ? "danger" : "warning")">
                                    @Model.PaymentStatus
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>Shipping Address:</th>
                            <td>@Model.ShippingAddress</td>
                        </tr>
                        <tr>
                            <th>Billing Address:</th>
                            <td>@Model.BillingAddress</td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (Model.PaymentStatus == "Pending")
            {
                <div class="card mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Payment Pending</h5>
                    </div>
                    <div class="card-body">
                        <p>Your order has been registered, but payment is still pending.</p>
                        <p>To complete your order, please make payment using one of the available methods:</p>

                        <div class="d-grid gap-2 mt-3">
                            <a href="@Url.Action("Process", "Payment", new { id = Model.OrderId })" class="btn btn-primary">
                                <i class="fas fa-credit-card me-2"></i>Pay Now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="order-items mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <span class="fw-bold">@item.ProductName</span>
                                    <span class="text-muted"> x @item.Quantity</span>
                                </div>
                                <span>@string.Format("{0:F2}", item.Subtotal) MDL</span>
                            </div>
                        }
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>@string.Format("{0:F2}", Model.Items.Sum(i => i.Subtotal)) MDL</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        @{
                            decimal subtotal = Model.Items.Sum(i => i.Subtotal);
                            decimal shipping = subtotal > 900 ? 0 : 150;
                        }
                        <span>@(shipping == 0 ? "FREE" : string.Format("{0:F2}", shipping) + " MDL")</span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold">@string.Format("{0:F2}", Model.TotalAmount) MDL</span>
                    </div>

                    <div class="d-grid gap-2">
                        @if (Model.PaymentStatus == "Pending")
                        {
                            <a href="@Url.Action("Process", "Payment", new { id = Model.OrderId })" class="btn btn-success mb-2">
                                <i class="fas fa-credit-card me-2"></i>Pay Now
                            </a>
                        }
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Back to Store
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Currency formatter to match other pages
            function formatCurrency(price, locale = 'ro-MD', currency = 'MDL') {
                // Ensure price has correct decimal places
                price = parseFloat(parseFloat(price).toFixed(2));

                // Format using Intl API
                let formatted = new Intl.NumberFormat(locale, {
                    style: 'currency',
                    currency: currency,
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(price);

                // Ensure the currency is MDL, even if the browser changes it
                if (formatted.includes(' L') && !formatted.includes('MDL')) {
                    formatted = formatted.replace(' L', ' MDL');
                }

                // Clean up any duplications
                if (formatted.includes('MDL MDL') || formatted.includes('L MDL')) {
                    formatted = formatted.replace(' MDL', '');
                    formatted = formatted.replace(' L', '') + ' MDL';
                }

                // If the browser ignores our locale/currency settings, manually format it
                if (!formatted.includes('MDL')) {
                    formatted = formatted.replace(/[$€£¥₽]/g, '').trim() + ' MDL';
                }

                return formatted;
            }

            // Fix all price displays on the page
            function fixPriceDisplays() {
                // Fix item prices
                const itemPrices = document.querySelectorAll('.order-items span:not(.fw-bold):not(.text-muted)');
                itemPrices.forEach(el => {
                    const text = el.textContent.trim();
                    // Extract numeric value and reformat
                    const match = text.match(/[\d,]+[.,]\d{2}/);
                    if (match) {
                        const numericValue = parseFloat(match[0].replace(',', '.'));
                        if (!isNaN(numericValue)) {
                            el.textContent = formatCurrency(numericValue);
                        }
                    }
                });

                // Fix subtotal, shipping, and total
                const summaryElements = document.querySelectorAll('.d-flex.justify-content-between span:last-child');
                summaryElements.forEach(el => {
                    const text = el.textContent.trim();
                    if (text === 'FREE') return; // Don't change FREE shipping

                    // Extract numeric value and reformat
                    const match = text.match(/[\d,]+[.,]\d{2}/);
                    if (match) {
                        const numericValue = parseFloat(match[0].replace(',', '.'));
                        if (!isNaN(numericValue)) {
                            el.textContent = formatCurrency(numericValue);
                        }
                    }
                });
            }

            // Run the fix
            fixPriceDisplays();

            // Also fix any prices that might be loaded dynamically
            setTimeout(fixPriceDisplays, 500);
        });
    </script>
} 