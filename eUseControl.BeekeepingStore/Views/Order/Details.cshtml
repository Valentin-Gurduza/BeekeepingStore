@model eUseControl.BeekeepingStore.Domain.Entities.Order.OrderResponse

@{
    ViewBag.Title = "Order Details #" + Model.OrderId;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-0">Order #@Model.OrderId</h1>
                <div>
                    <a href="@Url.Action("History", "Order")" class="btn btn-outline-primary me-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to Orders
                    </a>
                    @if (Model.OrderStatus == "Pending" || Model.OrderStatus == "Processing")
                    {
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                            <i class="fas fa-times me-2"></i>Cancel Order
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table">
                                <tr>
                                    <th style="width: 200px;">Order Number:</th>
                                    <td>#@Model.OrderId</td>
                                </tr>
                                <tr>
                                    <th>Date:</th>
                                    <td>@Model.OrderDate.ToString("dd.MM.yyyy, HH:mm")</td>
                                </tr>
                                <tr>
                                    <th>Order Status:</th>
                                    <td>
                                        <span class="badge bg-@(Model.OrderStatus == "Delivered" ? "success" :
                                                                Model.OrderStatus == "Cancelled" ? "danger" :
                                                                Model.OrderStatus == "Shipped" ? "info" : "warning")">
                                            @Model.OrderStatus
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Payment Status:</th>
                                    <td>
                                        <span class="badge bg-@(Model.PaymentStatus == "Completed" ? "success" :
                                                                Model.PaymentStatus == "Failed" ? "danger" :
                                                                "warning")">
                                            @Model.PaymentStatus
                                        </span>
                                        @if (Model.PaymentStatus == "Pending" && Model.OrderStatus != "Cancelled")
                                        {
                                            <a href="@Url.Action("Process", "Payment", new { id = Model.OrderId })" class="btn btn-sm btn-success ms-2">
                                                <i class="fas fa-credit-card me-1"></i> Pay Now
                                            </a>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table">
                                <tr>
                                    <th style="width: 200px;">Payment Method:</th>
                                    <td>@Model.PaymentMethod</td>
                                </tr>
                                @if (Model.ShippedDate.HasValue)
                                {
                                    <tr>
                                        <th>Shipped Date:</th>
                                        <td>@Model.ShippedDate.Value.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                                {
                                    <tr>
                                        <th>Tracking Number:</th>
                                        <td>@Model.TrackingNumber</td>
                                    </tr>
                                }
                                <tr>
                                    <th>Total:</th>
                                    <td><strong>@string.Format("{0:F2}", Model.TotalAmount) MDL</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Ordered Products</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Price</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div>
                                                <a href="@Url.Action("Details", "Product", new { id = item.ProductId })">@item.ProductName</a>
                                            </div>
                                        </td>
                                        <td class="text-center">@string.Format("{0:F2}", item.UnitPrice) MDL</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@string.Format("{0:F2}", item.Subtotal) MDL</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end">Subtotal:</td>
                                    <td class="text-end">@string.Format("{0:F2}", Model.Items.Sum(i => i.Subtotal)) MDL</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end">Shipping:</td>
                                    @{
                                        decimal subtotal = Model.Items.Sum(i => i.Subtotal);
                                        decimal shipping = subtotal > 900 ? 0 : 150;
                                    }
                                    <td class="text-end">@(shipping == 0 ? "FREE" : string.Format("{0:F2}", shipping) + " MDL")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td class="text-end"><strong>@string.Format("{0:F2}", Model.TotalAmount) MDL</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Addresses</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="mb-2">Shipping Address</h6>
                        <address class="mb-0">
                            @Html.Raw(Model.ShippingAddress.Replace(Environment.NewLine, "<br />"))
                        </address>
                    </div>

                    <div>
                        <h6 class="mb-2">Billing Address</h6>
                        <address class="mb-0">
                            @Html.Raw(Model.BillingAddress.Replace(Environment.NewLine, "<br />"))
                        </address>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Order Notes</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Html.Raw(Model.Notes.Replace(Environment.NewLine, "<br />"))</p>
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order History</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-primary rounded-pill me-2">1</span>
                                Order Placed
                            </div>
                            <small class="text-muted">@Model.OrderDate.ToString("dd.MM.yyyy, HH:mm")</small>
                        </li>
                        @if (Model.OrderStatus != "Pending" && Model.OrderStatus != "Cancelled")
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-primary rounded-pill me-2">2</span>
                                    Order Processed
                                </div>
                                <small class="text-muted">@Model.OrderDate.AddHours(2).ToString("dd.MM.yyyy, HH:mm")</small>
                            </li>
                        }
                        @if (Model.OrderStatus == "Shipped" || Model.OrderStatus == "Delivered")
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-primary rounded-pill me-2">3</span>
                                    Order Shipped
                                </div>
                                <small class="text-muted">@(Model.ShippedDate.HasValue ? Model.ShippedDate.Value.ToString("dd.MM.yyyy, HH:mm") : Model.OrderDate.AddDays(1).ToString("dd.MM.yyyy, HH:mm"))</small>
                            </li>
                        }
                        @if (Model.OrderStatus == "Delivered")
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-primary rounded-pill me-2">4</span>
                                    Order Delivered
                                </div>
                                <small class="text-muted">@(Model.ShippedDate.HasValue ? Model.ShippedDate.Value.AddDays(2).ToString("dd.MM.yyyy, HH:mm") : Model.OrderDate.AddDays(3).ToString("dd.MM.yyyy, HH:mm"))</small>
                            </li>
                        }
                        @if (Model.OrderStatus == "Cancelled")
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-danger">
                                <div>
                                    <span class="badge bg-danger rounded-pill me-2">X</span>
                                    Order Cancelled
                                </div>
                                <small class="text-muted">@Model.OrderDate.AddHours(1).ToString("dd.MM.yyyy, HH:mm")</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Order Modal -->
@if (Model.OrderStatus == "Pending" || Model.OrderStatus == "Processing")
{
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelOrderModalLabel">Confirm Order Cancellation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel order #@Model.OrderId?</p>
                    <p>This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="@Url.Action("Cancel", "Order", new { id = Model.OrderId })" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Cancel Order</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Currency formatter to match other pages
            function formatCurrency(price, locale = 'ro-MD', currency = 'MDL') {
                // Ensure price has correct decimal places
                price = parseFloat(parseFloat(price).toFixed(2));

                // Format using Intl API
                let formatted = new Intl.NumberFormat(locale, {
                    style: 'currency',
                    currency: currency,
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(price);

                // Ensure the currency is MDL, even if the browser changes it
                if (formatted.includes(' L') && !formatted.includes('MDL')) {
                    formatted = formatted.replace(' L', ' MDL');
                }

                // Clean up any duplications
                if (formatted.includes('MDL MDL') || formatted.includes('L MDL')) {
                    formatted = formatted.replace(' MDL', '');
                    formatted = formatted.replace(' L', '') + ' MDL';
                }

                // If the browser ignores our locale/currency settings, manually format it
                if (!formatted.includes('MDL')) {
                    formatted = formatted.replace(/[$€£¥₽]/g, '').trim() + ' MDL';
                }

                return formatted;
            }

            // Fix all price displays on the page
            function fixPriceDisplays() {
                // Fix any remaining currency formatting issues
                const priceElements = document.querySelectorAll('td, th, span');
                priceElements.forEach(el => {
                    const text = el.textContent.trim();
                    // Look for prices that might need fixing
                    if (text.includes('L') && !text.includes('MDL') && text.match(/[\d,]+[.,]\d{2}/)) {
                        const match = text.match(/[\d,]+[.,]\d{2}/);
                        if (match) {
                            const numericValue = parseFloat(match[0].replace(',', '.'));
                            if (!isNaN(numericValue)) {
                                el.textContent = text.replace(match[0] + ' L', formatCurrency(numericValue));
                            }
                        }
                    }
                });
            }

            // Run the fix
            fixPriceDisplays();
        });
    </script>
} 