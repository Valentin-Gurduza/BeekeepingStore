@model eUseControl.BeekeepingStore.Domain.Entities.Blog.BlogPost

@{
    ViewBag.Title = "Edit Blog Post";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-edit"></i> Edit Blog Post</h3>
                    <p class="mb-0 text-muted">Update your blog post content</p>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Edit", "Blog", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.BlogPostId)
                        @Html.HiddenFor(model => model.PublishDate)
                        @Html.HiddenFor(model => model.ViewCount)

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Title, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Title, new { @class = "form-control", placeholder = "Enter an engaging title for your post", required = "required" })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Summary, new { @class = "form-label" })
                            @Html.TextAreaFor(model => model.Summary, new { @class = "form-control", rows = "3", placeholder = "Write a brief summary of your post (optional)" })
                            @Html.ValidationMessageFor(model => model.Summary, "", new { @class = "text-danger" })
                            <div class="form-text">A short description that will appear in post previews.</div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Category, new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.Category, new SelectList(new[]
                            {
                                new { Value = "", Text = "Select a category..." },
                                new { Value = "Beekeeping Basics", Text = "Beekeeping Basics" },
                                new { Value = "Hive Management", Text = "Hive Management" },
                                new { Value = "Honey Production", Text = "Honey Production" },
                                new { Value = "Bee Health", Text = "Bee Health" },
                                new { Value = "Equipment Reviews", Text = "Equipment Reviews" },
                                new { Value = "Seasonal Tips", Text = "Seasonal Tips" },
                                new { Value = "Troubleshooting", Text = "Troubleshooting" },
                                new { Value = "Personal Experience", Text = "Personal Experience" },
                                new { Value = "Other", Text = "Other" }
                            }, "Value", "Text", Model.Category), new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Tags, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Tags, new { @class = "form-control", placeholder = "beekeeping, honey, hive management (separate with commas)" })
                            @Html.ValidationMessageFor(model => model.Tags, "", new { @class = "text-danger" })
                            <div class="form-text">Add relevant tags separated by commas to help readers find your post.</div>
                        </div>

                        <div class="mb-3">
                            <label for="featuredImage" class="form-label">Featured Image</label>
                            @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                            {
                                <div class="mb-2">
                                    <img src="@Url.Content(Model.FeaturedImage)" alt="Current featured image" class="img-thumbnail" style="max-height: 200px;">
                                    <div class="form-text">Current featured image</div>
                                </div>
                            }
                            <input type="file" class="form-control" id="featuredImage" name="featuredImage" accept="image/*">
                            <div class="form-text">Upload a new image to replace the current one (optional).</div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Content, new { @class = "form-label" })

                            <!-- Quill Editor Container -->
                            <div id="quill-editor" style="height: 400px; background: white;"></div>

                            <!-- Hidden textarea pentru a trimite datele -->
                            @Html.TextAreaFor(model => model.Content, new { @class = "d-none", id = "blogContent", required = "required" })
                            @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })

                            <div class="form-text mt-2">
                                <i class="fas fa-info-circle"></i> Folosește editorul de mai sus pentru a formata textul ca în Microsoft Word.
                                Poți adăuga titluri, text bold/italic, liste, linkuri și multe altele.
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Slug, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Slug, new { @class = "form-control", placeholder = "URL slug (leave empty to auto-generate)" })
                            @Html.ValidationMessageFor(model => model.Slug, "", new { @class = "text-danger" })
                            <div class="form-text">The URL-friendly version of your title. Leave empty to auto-generate.</div>
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Note:</strong> After editing, your post will need to be re-approved by an admin before it becomes visible to other users.
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("MyPosts", "Blog")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Back to My Posts
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Post
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quill.js CSS și JS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
    // Inițializare Quill Editor
    var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Editează conținutul postării tale aici...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                [{ 'indent': '-1' }, { 'indent': '+1' }],
                [{ 'align': [] }],
                ['link', 'image'],
                ['blockquote', 'code-block'],
                ['clean']
            ]
        }
    });

    // Încarcă conținutul existent
    document.addEventListener('DOMContentLoaded', function () {
        var existingContent = document.querySelector('#blogContent').value;
        if (existingContent) {
            quill.root.innerHTML = existingContent;
        }
    });

    // Sincronizare cu textarea ascuns
    var form = document.querySelector('form');
    form.onsubmit = function () {
        // Actualizează textarea ascuns cu conținutul din Quill
        var blogContent = document.querySelector('#blogContent');
        blogContent.value = quill.root.innerHTML;

        // Verifică dacă editorul are conținut
        if (quill.getText().trim().length === 0) {
            alert('Te rog să adaugi conținut pentru postarea ta.');
            return false;
        }

        return true;
    };

    // Form validation
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            var forms = document.getElementsByClassName('needs-validation');
            var validation = Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    // Actualizează textarea înainte de validare
                    var blogContent = document.querySelector('#blogContent');
                    blogContent.value = quill.root.innerHTML;

                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();
</script>

<style>
    /* Stiluri pentru Quill Editor */
    .ql-editor {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        min-height: 300px;
    }

    .ql-toolbar {
        border-top: 1px solid #ccc;
        border-left: 1px solid #ccc;
        border-right: 1px solid #ccc;
        background: #f8f9fa;
    }

    .ql-container {
        border-bottom: 1px solid #ccc;
        border-left: 1px solid #ccc;
        border-right: 1px solid #ccc;
        border-radius: 0 0 0.375rem 0.375rem;
    }

    .ql-toolbar.ql-snow {
        border-radius: 0.375rem 0.375rem 0 0;
    }

    /* Stiluri pentru card */
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    /* Stiluri pentru imagine */
    .img-thumbnail {
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        padding: 0.25rem;
    }

    /* Responsive pentru editor */
    @@media (max-width: 768px) {
        .ql-editor {
            font-size: 14px;
            min-height: 250px;
        }

        #quill-editor {
            height: 300px !important;
        }
    }
</style> 