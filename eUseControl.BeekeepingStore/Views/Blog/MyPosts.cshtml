@model List<eUseControl.BeekeepingStore.Domain.Entities.Blog.BlogPost>

@{
    ViewBag.Title = "My Blog Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-blog"></i> My Blog Posts</h2>
                <a href="@Url.Action("Create", "Blog")" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Write New Post
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var post in Model.OrderByDescending(p => p.PublishDate))
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrEmpty(post.FeaturedImage))
                                {
                                    <img src="@Url.Content(post.FeaturedImage)" class="card-img-top" alt="@post.Title" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                        <span class="text-muted">No image</span>
                                    </div>
                                }

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@post.Title</h5>

                                    <div class="mb-2">
                                        @if (post.IsPublished)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Awaiting Approval</span>
                                        }

                                        @if (!string.IsNullOrEmpty(post.Category))
                                        {
                                            <span class="badge bg-secondary">@post.Category</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(post.Summary))
                                    {
                                        <p class="card-text">@Html.Raw(post.Summary.Length > 100 ? post.Summary.Substring(0, 100) + "..." : post.Summary)</p>
                                    }
                                    else if (!string.IsNullOrEmpty(post.Content))
                                    {
                                        <p class="card-text">@Html.Raw(post.Content.Length > 100 ? post.Content.Substring(0, 100) + "..." : post.Content)</p>
                                    }

                                    <div class="mt-auto">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> @post.PublishDate.ToString("MMM dd, yyyy")
                                            <i class="fas fa-eye ms-2"></i> @post.ViewCount views
                                        </small>

                                        <div class="btn-group w-100 mt-2" role="group">
                                            @if (post.IsPublished)
                                            {
                                                <a href="@Url.Action("Post", "Blog", new { slug = post.Slug })" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                            }
                                            <a href="@Url.Action("Edit", "Blog", new { id = post.BlogPostId })" class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <a href="@Url.Action("Delete", "Blog", new { id = post.BlogPostId })" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash"></i> Delete
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <p class="text-muted">
                        <i class="fas fa-info-circle"></i>
                        You have <strong>@Model.Count</strong> blog post(s).
                        Published posts are visible to all visitors, while unpublished posts are awaiting admin approval.
                    </p>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-blog fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No Blog Posts Yet</h4>
                    <p class="text-muted">You haven't written any blog posts yet. Start sharing your beekeeping knowledge!</p>
                    <a href="@Url.Action("Create", "Blog")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Write Your First Post
                    </a>
                </div>
            }

            <div class="mt-4">
                <a href="@Url.Action("Index", "Blog")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to All Posts
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .badge {
        font-size: 0.75em;
    }
</style> 