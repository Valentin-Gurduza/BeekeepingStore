@model eUseControl.BeekeepingStore.Domain.Entities.Blog.BlogPost

@{
    ViewBag.Title = "Delete Blog Post";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-trash text-danger me-2"></i>Delete Blog Post</h2>
    <a href="@Url.Action("BlogPosts")" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Blog Posts
    </a>
</div>

<div class="alert alert-danger">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <strong>Warning!</strong> This action will permanently delete this blog post and cannot be undone.
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="stat-card">
            <h5 class="mb-3">Are you sure you want to delete this blog post?</h5>

            <!-- Post Preview -->
            <div class="border rounded p-3 mb-4 bg-light">
                @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                {
                    <div class="mb-3">
                        <img src="@Url.Content(Model.FeaturedImage)"
                             alt="@Model.Title"
                             class="img-fluid rounded"
                             style="max-height: 200px;">
                    </div>
                }
                else
                {
                    <div class="mb-3 d-flex align-items-center justify-content-center bg-light rounded" style="height: 200px;">
                        <div class="text-center text-muted">
                            <i class="fas fa-image fa-3x mb-2"></i>
                            <p class="mb-0">No image</p>
                        </div>
                    </div>
                }

                <h4 class="mb-2">@Model.Title</h4>

                <div class="text-muted mb-3">
                    <small>
                        <i class="fas fa-calendar-alt me-1"></i>@Model.PublishDate.ToString("MMMM dd, yyyy")
                        <span class="mx-2">|</span>
                        <i class="fas fa-user me-1"></i>@(string.IsNullOrEmpty(Model.Author) ? "Admin" : Model.Author)
                        @if (!string.IsNullOrEmpty(Model.Category))
                        {
                            <span class="mx-2">|</span>
                            <i class="fas fa-folder me-1"></i>@Model.Category
                        }
                        <span class="mx-2">|</span>
                        <i class="fas fa-eye me-1"></i>@Model.ViewCount Views
                    </small>
                </div>

                @if (!string.IsNullOrEmpty(Model.Summary))
                {
                    <p class="text-muted">@Model.Summary</p>
                }

                <div class="mt-3">
                    @if (Model.IsPublished)
                    {
                        <span class="badge bg-success me-2">Published</span>
                    }
                    else
                    {
                        <span class="badge bg-warning me-2">Draft</span>
                    }

                    @if (!string.IsNullOrEmpty(Model.Tags))
                    {
                        foreach (var tag in Model.Tags.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)))
                        {
                            <span class="badge bg-secondary me-1">#@tag</span>
                        }
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <div>
                    @using (Html.BeginForm("BlogDelete", "AdminDashboard", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", Model.BlogPostId)
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Yes, Delete This Post
                        </button>
                    }
                </div>
                <div>
                    <a href="@Url.Action("BlogPosts")" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                    <a href="@Url.Action("BlogEdit", new { id = Model.BlogPostId })" class="btn btn-outline-primary ms-2">
                        <i class="fas fa-edit me-1"></i>Edit Instead
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Post Statistics -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-chart-line me-1"></i>Post Statistics</h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="stat-value text-primary">@Model.ViewCount</div>
                        <div class="stat-label">Views</div>
                    </div>
                    <div class="col-6">
                        <div class="stat-value text-success">@(Model.Comments?.Count(c => c.IsApproved) ?? 0)</div>
                        <div class="stat-label">Comments</div>
                    </div>
                </div>
                <hr>
                <div class="row text-center">
                    <div class="col-12">
                        <div class="stat-value text-warning">@(Model.Comments?.Count(c => !c.IsApproved) ?? 0)</div>
                        <div class="stat-label">Pending Comments</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deletion Impact -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-exclamation-triangle text-warning me-1"></i>Deletion Impact</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="fas fa-file-alt text-danger me-2"></i>
                        Blog post will be permanently deleted
                    </li>
                    @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                    {
                        <li class="mb-2">
                            <i class="fas fa-image text-danger me-2"></i>
                            Featured image will be deleted
                        </li>
                    }
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        <li class="mb-2">
                            <i class="fas fa-comments text-danger me-2"></i>
                            @Model.Comments.Count comment(s) will be deleted
                        </li>
                    }
                    <li class="mb-2">
                        <i class="fas fa-link text-warning me-2"></i>
                        External links to this post will be broken
                    </li>
                    <li>
                        <i class="fas fa-undo text-muted me-2"></i>
                        This action cannot be undone
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div> 