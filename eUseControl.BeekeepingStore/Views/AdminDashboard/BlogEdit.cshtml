@model eUseControl.BeekeepingStore.Domain.Entities.Blog.BlogPost

@{
    ViewBag.Title = "Edit Blog Post";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit me-2"></i>Edit Blog Post</h2>
    <div>
        @if (Model.IsPublished)
        {
            <a href="@Url.Action("Post", "Blog", new { slug = Model.Slug })" class="btn btn-outline-primary me-2" target="_blank">
                <i class="fas fa-eye me-1"></i>View Post
            </a>
        }
        <a href="@Url.Action("BlogPosts")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Blog Posts
        </a>
    </div>
</div>

<div class="stat-card">
    @using (Html.BeginForm("BlogEdit", "AdminDashboard", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.BlogPostId)
        @Html.HiddenFor(m => m.ViewCount)
        @Html.HiddenFor(m => m.FeaturedImage)

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter blog post title..." })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Summary, "Summary (Optional)", new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.Summary, new { @class = "form-control", rows = "3", placeholder = "Brief summary of the blog post..." })
                    @Html.ValidationMessageFor(m => m.Summary, "", new { @class = "text-danger" })
                    <div class="form-text">This will be displayed in blog listings and search results.</div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Content, new { @class = "form-label" })

                    <!-- Quill Editor Container -->
                    <div id="quill-editor" style="height: 400px; background: white;"></div>

                    <!-- Hidden textarea pentru a trimite datele -->
                    @Html.TextAreaFor(m => m.Content, new { @class = "d-none", id = "blogContent" })
                    @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger" })
                    <div class="form-text">
                        <i class="fas fa-info-circle"></i> Folosește editorul de mai sus pentru a formata textul ca în Microsoft Word.
                        Poți adăuga titluri, text bold/italic, liste, linkuri și multe altele.
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Post Statistics -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-chart-line me-1"></i>Post Statistics</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="stat-value text-primary">@Model.ViewCount</div>
                                <div class="stat-label">Views</div>
                            </div>
                            <div class="col-6">
                                <div class="stat-value text-success">@(Model.Comments?.Count(c => c.IsApproved) ?? 0)</div>
                                <div class="stat-label">Comments</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Publish Settings -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-cog me-1"></i>Publish Settings</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.PublishDate, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.PublishDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(m => m.PublishDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsPublished, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsPublished, "Published", new { @class = "form-check-label" })
                            </div>
                            <div class="form-text">Uncheck to save as draft</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Update Blog Post
                            </button>
                            <a href="@Url.Action("BlogPosts")" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Featured Image -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-image me-1"></i>Featured Image</h6>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                        {
                            <div class="mb-3 text-center" id="currentImage">
                                <img src="@Url.Content(Model.FeaturedImage)"
                                     alt="Current featured image"
                                     class="img-fluid rounded"
                                     style="max-height: 200px;">
                                <div class="mt-2">
                                    <small class="text-muted">Current featured image</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 text-center d-flex align-items-center justify-content-center bg-light rounded" style="height: 200px;">
                                <div class="text-muted">
                                    <i class="fas fa-image fa-3x mb-2"></i>
                                    <p class="mb-0">No image uploaded</p>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="featuredImageInput" class="form-label">
                                @(string.IsNullOrEmpty(Model.FeaturedImage) ? "Upload Featured Image" : "Replace Featured Image")
                            </label>
                            <input type="file" name="featuredImage" class="form-control" accept="image/*" id="featuredImageInput">
                            <div class="form-text">Supported formats: JPG, JPEG, PNG, GIF. Recommended size: 800x400px</div>
                        </div>

                        <div id="imagePreview" class="text-center" style="display: none;">
                            <img id="previewImg" src="" alt="Preview" class="img-fluid rounded" style="max-height: 200px;">
                            <div class="mt-2">
                                <small class="text-muted">New image preview</small><br>
                                <button type="button" class="btn btn-sm btn-outline-danger mt-1" onclick="removeImage()">
                                    <i class="fas fa-trash me-1"></i>Remove
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Categories and Tags -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-tags me-1"></i>Categories & Tags</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Category, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "e.g., Beginner Guides" })
                            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Tags, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Tags, new { @class = "form-control", placeholder = "beekeeping, honey, tips" })
                            @Html.ValidationMessageFor(m => m.Tags, "", new { @class = "text-danger" })
                            <div class="form-text">Separate tags with commas</div>
                        </div>
                    </div>
                </div>

                <!-- SEO Settings -->
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-search me-1"></i>SEO Settings</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Slug, "URL Slug", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Slug, new { @class = "form-control", placeholder = "auto-generated-from-title" })
                            @Html.ValidationMessageFor(m => m.Slug, "", new { @class = "text-danger" })
                            <div class="form-text">Leave empty to auto-generate from title</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <!-- Quill.js CSS și JS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        // Inițializare Quill Editor
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Editează conținutul postării aici...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'indent': '-1' }, { 'indent': '+1' }],
                    [{ 'align': [] }],
                    ['link', 'image'],
                    ['blockquote', 'code-block'],
                    ['clean']
                ]
            }
        });

        // Încarcă conținutul existent
        document.addEventListener('DOMContentLoaded', function () {
            var existingContent = document.querySelector('#blogContent').value;
            if (existingContent) {
                quill.root.innerHTML = existingContent;
            }
        });

        // Sincronizare cu textarea ascuns
        var form = document.querySelector('form');
        form.onsubmit = function () {
            // Actualizează textarea ascuns cu conținutul din Quill
            var blogContent = document.querySelector('#blogContent');
            blogContent.value = quill.root.innerHTML;

            // Verifică dacă editorul are conținut
            if (quill.getText().trim().length === 0) {
                alert('Te rog să adaugi conținut pentru postarea ta.');
                return false;
            }

            return true;
        };

        $(document).ready(function () {
            // Auto-generate slug from title (only if slug is empty)
            $('#Title').on('input', function () {
                var currentSlug = $('#Slug').val().trim();
                if (!currentSlug) {
                    var title = $(this).val();
                    var slug = title.toLowerCase()
                        .replace(/[^a-z0-9\s-]/g, '') // Remove special characters
                        .replace(/\s+/g, '-') // Replace spaces with hyphens
                        .replace(/-+/g, '-') // Replace multiple hyphens with single
                        .replace(/^-|-$/g, ''); // Remove leading/trailing hyphens

                    $('#Slug').val(slug);
                }
            });

            // Image preview functionality
            $('#featuredImageInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#previewImg').attr('src', e.target.result);
                        $('#imagePreview').show();
                    };
                    reader.readAsDataURL(file);
                }
            });
        });

        function removeImage() {
            $('#featuredImageInput').val('');
            $('#imagePreview').hide();
            $('#previewImg').attr('src', '');
        }

        // Form validation before submit
        $('form').on('submit', function (e) {
            // Basic validation
            var title = $('#Title').val().trim();
            var content = $('#blogContent').val().trim();

            if (!title) {
                alert('Please enter a title for your blog post.');
                e.preventDefault();
                return false;
            }

            if (!content) {
                alert('Please enter content for your blog post.');
                e.preventDefault();
                return false;
            }

            return true;
        });
    </script>

    <style>
        /* Stiluri pentru Quill Editor */
        .ql-editor {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            min-height: 300px;
        }

        .ql-toolbar {
            border-top: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            background: #f8f9fa;
        }

        .ql-container {
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            border-radius: 0 0 0.375rem 0.375rem;
        }

        .ql-toolbar.ql-snow {
            border-radius: 0.375rem 0.375rem 0 0;
        }

        /* Responsive pentru editor */
        @@media (max-width: 768px) {
            .ql-editor {
                font-size: 14px;
                min-height: 250px;
            }

            #quill-editor {
                height: 300px !important;
            }
        }
    </style>
} 