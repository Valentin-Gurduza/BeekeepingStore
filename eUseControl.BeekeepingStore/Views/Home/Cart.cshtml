                testButton.className = 'btn btn-info btn-sm';
                testButton.style.position = 'fixed';
                testButton.style.top = '530px';
                testButton.style.right = '10px';
                testButton.style.zIndex = '9999';
                testButton.onclick = window.testSiteJsFunctions;
                document.body.appendChild(testButton);

                // Add duplicate removal test button
                const duplicateButton = document.createElement('button');
                duplicateButton.textContent = 'Remove Duplicates';
                duplicateButton.className = 'btn btn-secondary btn-sm';
                duplicateButton.style.position = 'fixed';
                duplicateButton.style.top = '570px';
                duplicateButton.style.right = '10px';
                duplicateButton.style.zIndex = '9999';
                duplicateButton.onclick = window.removeDuplicates;
                document.body.appendChild(duplicateButton);
            }
        });

        /**
         * Function to fix all currency displays to show MDL instead of L
         */
        function fixCurrencyDisplays() {
            // Find all elements that might contain currency
            const currencyElements = document.querySelectorAll('.cart-subtotal, .cart-shipping, .cart-total, .fw-bold');

            currencyElements.forEach(el => {
                const currentText = el.textContent.trim();

                // Check if it contains "L" but not "MDL"
                if (currentText.includes(' L') && !currentText.includes('MDL')) {
                    const newText = currentText.replace(' L', ' MDL');
                    el.textContent = newText;
                    console.log(`[CURRENCY FIX] Updated: ${currentText} -> ${newText}`);
                }

                // Also fix cases where it might be just "L" at the end
                if (currentText.endsWith(' L') && !currentText.includes('MDL')) {
                    const newText = currentText.replace(' L', ' MDL');
                    el.textContent = newText;
                    console.log(`[CURRENCY FIX] Updated: ${currentText} -> ${newText}`);
                }
            });
        }

        // Run currency fix when cart is rendered
        document.addEventListener('cartRendered', function () {
            console.log("[CURRENCY FIX] Cart rendered, fixing currency displays...");
            setTimeout(fixCurrencyDisplays, 100);
        });

        // Also run on page load
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(fixCurrencyDisplays, 500);
            setTimeout(fixCurrencyDisplays, 1500);
            setTimeout(fixCurrencyDisplays, 3000);
        });

        /**
         * Function to remove crossed-out prices from wrong places
         */
        function removeWrongCrossedOutPrices() {
            console.log("[CART FIX] Removing crossed-out prices from wrong places");

            // Find all cart items
            const cartItemElements = document.querySelectorAll('.cart-item');

            cartItemElements.forEach(item => {
                // Find the Total column (text-end column)
                const totalColumn = item.querySelector('.col-lg-2.col-md-2.col-sm-4.mt-3.mt-sm-0.text-end');
                if (totalColumn) {
                    // Remove any crossed-out prices from Total column
                    const crossedOutElements = totalColumn.querySelectorAll('.text-decoration-line-through, .original-price-display');
                    crossedOutElements.forEach(el => {
                        console.log("[CART FIX] Removing crossed-out price from Total column:", el.textContent);
                        el.remove();
                    });

                    // Also remove any small elements that might contain crossed-out prices
                    const smallElements = totalColumn.querySelectorAll('small');
                    smallElements.forEach(el => {
                        if (el.textContent.includes('MDL') || el.textContent.includes('L')) {
                            console.log("[CART FIX] Removing small price element from Total column:", el.textContent);
                            el.remove();
                        }
                    });
                }

                // Remove crossed-out prices from anywhere near Remove button
                const removeButton = item.querySelector('.delete-item');
                if (removeButton && removeButton.parentNode) {
                    const parentNode = removeButton.parentNode;
                    const crossedOutElements = parentNode.querySelectorAll('.text-decoration-line-through, .original-price-display');
                    crossedOutElements.forEach(el => {
                        console.log("[CART FIX] Removing crossed-out price from Remove area:", el.textContent);
                        el.remove();
                    });
                }
            });
        }

        /**
         * Function to remove duplicate crossed-out prices
         */
        function removeDuplicateCrossedOutPrices() {
            console.log("[CART FIX] Removing duplicate crossed-out prices");

            // Find all cart items
            const cartItemElements = document.querySelectorAll('.cart-item');

            cartItemElements.forEach(item => {
                // Find the Price column
                const priceColumn = item.querySelector('.col-lg-2.col-md-2.col-sm-4.mt-3.mt-sm-0.text-center');
                if (!priceColumn) return;

                // Find all crossed-out price elements in the Price column
                const crossedOutElements = priceColumn.querySelectorAll('.text-decoration-line-through, .original-price-display');

                if (crossedOutElements.length > 1) {
                    console.log(`[CART FIX] Found ${crossedOutElements.length} crossed-out prices, removing duplicates`);

                    // Keep only the first one, remove the rest
                    for (let i = 1; i < crossedOutElements.length; i++) {
                        console.log(`[CART FIX] Removing duplicate: ${crossedOutElements[i].textContent}`);
                        crossedOutElements[i].remove();
                    }
                }
            });
        }

        // Run the cleanup function after ensuring promotional prices
        function ensurePromotionalPricesWithCleanup() {
            ensurePromotionalPrices();
            setTimeout(removeWrongCrossedOutPrices, 100);
            setTimeout(removeDuplicateCrossedOutPrices, 150);
        }
    </script>
}